<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ParaBank Automation Suite"
       parallel="tests"
       thread-count="3">

    <listeners>
        <listener class-name="reports.ExtentTestListener"/>
    </listeners>

    <!-- Chrome -->
    <test name="Chrome Tests">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="tests.BankingWorkflowTest"/>
            <class name="tests.LoginDataDrivenTest"/>
        </classes>

    </test>


    <!-- Firefox -->
    <test name="Firefox Tests">

        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="tests.BankingWorkflowTest"/>
            <class name="tests.LoginDataDrivenTest"/>
        </classes>

    </test>


    <!-- Edge -->
    <test name="Edge Tests">

        <parameter name="browser" value="edge"/>

        <classes>
            <class name="tests.BankingWorkflowTest"/>
            <class name="tests.LoginDataDrivenTest"/>
        </classes>

    </test>

</suite>